# Node
node_modules/
dist/
*.local

# Rust / Tauri
# target/ sits at the root, not under src-tauri/ — see .cargo/config.toml.
/target/
src-tauri/gen/

# Release packaging scratch (see .github/workflows/release.yml)
/dist-release/
/portable-staging/

# Secrets and machine-local settings. The app stores its own config in the
# OS config dir, not in the repo, but a developer pointing at a test server
# will reach for a dotenv sooner or later.
.env
.env.*
!.env.example

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# TypeScript incremental build state
*.tsbuildinfo
