{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BamDude Bridge",
  "version": "0.1.0",
  "identifier": "top.bamdude.bridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BamDude Bridge",
        "width": 560,
        "height": 660,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4OTQxODlCNTI5NTU3NkIKUldSclY1VlNteGlVeU8zbXZyS2d5KzdqRTd2dUlHQjV5bzdkc1pJVDJDNGVQVFBMUlJmRlhtWXYK",
      "endpoints": [
        "https://github.com/kainpl/bamdude-bridge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
